  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --blue: #0056B3;
      --blue-dark: #002D62;
      --blue-soft: #EBF3FA;
      --border: #C9D9EA;
      --bg: #F4F7FA;
      --card: #FFFFFF;
      --text: #002D62;
      --muted: #66788A;
      --green: #2E8B57;
      --green-soft: #E7F6EC;
      --gold: #E3A23B;
      --gold-soft: #FFF2D8;
      --input-bg: #F4F7FA;
      --hover: #F7FAFD;
      --shadow: 0 4px 16px rgba(0, 45, 98, .05);
      --board-bg: #002D62;
      --board-text: #FFFFFF;
      --board-muted: #C6D5E7;
      --board-item: rgba(255, 255, 255, .07);
      --board-border: rgba(255, 255, 255, .12);
      --radius: 14px;
      --sidebar: 260px;
    }

    body.dark-mode {
      --blue: #5865F2;
      --blue-dark: #1E1F22;
      --blue-soft: #35373C;
      --border: #1E1F22;
      --bg: #313338;
      --card: #2B2D31;
      --text: #F2F3F5;
      --muted: #B5BAC1;
      --green: #57F287;
      --green-soft: #193B2A;
      --gold: #F3BC5F;
      --gold-soft: #3B3020;
      --input-bg: #232428;
      --hover: #35373C;
      --shadow: 0 4px 16px rgba(0, 0, 0, .25);
      --board-bg: #1E1F22;
      --board-text: #F2F3F5;
      --board-muted: #B5BAC1;
      --board-item: rgba(255, 255, 255, .06);
      --board-border: rgba(255, 255, 255, .12);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
      transition: background-color .25s ease, color .25s ease;
    }
    a { text-decoration: none; color: inherit; }
    button, input { font: inherit; }

    /* Top Marquee Bar */
    .marquee {
      height: 38px;
      background: var(--blue);
      color: #fff;
      overflow: hidden;
      white-space: nowrap;
      border-bottom: 2px solid #8BB8E8;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
    }
    .marquee-track {
      display: inline-block;
      padding: 9px 0;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      animation: marquee 26s linear infinite;
    }
    .marquee-track span { margin-right: 48px; }
    @keyframes marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    /* Main Layout & Sidebar */
    .layout { display: flex; padding-top: 38px; min-height: 100vh; }
    .sidebar {
      width: var(--sidebar);
      height: calc(100vh - 38px);
      position: fixed;
      left: 0;
      top: 38px;
      background: var(--card);
      border-right: 1px solid var(--border);
      padding: 22px 16px;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      z-index: 100;
    }
    .brand { display: flex; align-items: center; gap: 11px; padding: 4px 8px 22px; }
    .brand-mark {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: var(--blue-soft);
      display: grid;
      place-items: center;
      overflow: hidden;
      flex: none;
    }
    .brand-mark img { width: 100%; height: 100%; object-fit: contain; padding: 5px; }
    .brand h1 { font-family: 'Playfair Display', serif; font-size: 22px; line-height: 1; margin: 0; }
    .brand p { font-size: 10px; margin: 4px 0 0; color: var(--muted); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    
    .search-box {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 11px;
      border: 1px solid var(--border);
      background: var(--input-bg);
      border-radius: 10px;
      margin: 0 4px 14px;
    }
    .search-box:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(0, 86, 179, .09); }
    .search-box svg { width: 16px; height: 16px; color: var(--muted); flex: none; }
    .search-box input { border: 0; outline: 0; background: transparent; width: 100%; font-size: 13px; color: var(--text); }
    
    .nav { display: flex; flex-direction: column; gap: 4px; }
    .nav a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 11px;
      border-radius: 9px;
      color: var(--muted);
      font-size: 14px;
      font-weight: 650;
    }
    .nav a svg { width: 17px; height: 17px; flex: none; }
    .nav a:hover { background: var(--hover); color: var(--blue); }
    .nav a.active { background: var(--blue-soft); color: var(--blue); }
    .nav-label { margin: 18px 11px 7px; font-size: 10px; color: #93A1B2; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    
    .theme-switch {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin: 14px 4px 12px;
      padding: 9px 11px;
      border: 1px solid var(--border);
      background: var(--input-bg);
      border-radius: 10px;
      color: var(--text);
      font-size: 12px;
      font-weight: 700;
    }
    .theme-switch button {
      width: 32px;
      height: 32px;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: var(--card);
      color: var(--text);
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: .2s ease;
    }
    .theme-switch button:hover { background: var(--hover); color: var(--blue); }
    .theme-switch svg { width: 16px; height: 16px; fill: currentColor; }
    .theme-label { display: flex; align-items: center; gap: 8px; }
    .theme-label svg { width: 15px; height: 15px; }

    .side-mini { background: var(--gold-soft); border: 1px solid var(--gold); border-radius: 12px; padding: 12px; }
    .side-mini strong { display: block; font-size: 12px; margin-bottom: 7px; }
    .side-mini div { font-size: 11px; color: var(--muted); margin-top: 5px; }

    /* Content Area */
    .main { margin-left: var(--sidebar); width: calc(100% - var(--sidebar)); padding: 42px 28px 64px; }
    .page { max-width: 1100px; margin: 0 auto; }
    .header { padding-bottom: 28px; border-bottom: 2px solid var(--border); }
    .eyebrow { font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--blue); margin-bottom: 8px; }
    .header h2 { font-family: 'Playfair Display', serif; font-size: 58px; line-height: 1.04; margin: 0 0 12px; letter-spacing: -.025em; }
    .header p { max-width: 760px; color: var(--muted); font-size: 16px; line-height: 1.7; margin: 0; }
    
    .section-title { font-family: 'Playfair Display', serif; font-size: 29px; margin: 34px 0 18px; display: flex; align-items: center; gap: 12px; }
    .section-title:after { content: ""; height: 1px; background: var(--border); flex: 1; }

    /* Grade Cards & Resources */
    .grade-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; margin-bottom: 18px; box-shadow: var(--shadow); }
    .grade-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
    .grade-title { display: flex; align-items: center; gap: 12px; }
    .grade-icon { width: 42px; height: 42px; border-radius: 11px; background: var(--blue-soft); color: var(--blue); display: grid; place-items: center; flex: none; }
    .grade-icon svg { width: 22px; height: 22px; }
    .grade-title h3 { margin: 0; font-size: 16px; color: var(--blue); text-transform: uppercase; letter-spacing: .04em; }
    .grade-title p { margin: 3px 0 0; font-size: 12px; color: var(--muted); }
    .active-badge { display: inline-flex; align-items: center; gap: 6px; background: var(--green-soft); color: var(--green); padding: 5px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; white-space: nowrap; }
    .active-badge:before { content: ""; width: 6px; height: 6px; background: var(--green); border-radius: 50%; }
    
    .resources { display: flex; flex-wrap: wrap; gap: 10px; }
    .file-link { position: relative; display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px 10px 11px; border-radius: 999px; border: 1.5px solid var(--border); background: var(--card); color: var(--blue); font-size: 13px; font-weight: 700; transition: .18s ease; }
    .file-link svg { width: 16px; height: 16px; flex: none; }
    .file-link:hover { transform: translateY(-2px); border-color: var(--blue); background: var(--blue-soft); box-shadow: 0 5px 16px rgba(0, 45, 98, .08); }
    .file-link.primary { background: var(--blue); color: #fff; border-color: var(--blue); }
    .file-link.primary:hover { background: var(--blue-dark); border-color: var(--blue-dark); }
    .new-badge { position: absolute; right: -5px; top: -8px; background: var(--gold); color: #fff; border-radius: 999px; padding: 2px 6px; font-size: 8px; font-weight: 800; letter-spacing: .04em; box-shadow: 0 2px 6px rgba(0, 0, 0, .12); }
    .updated { width: 100%; font-size: 11px; color: #93A1B2; margin-top: 2px; font-weight: 600; }

    /* Contributor Leaderboard */
    .board { margin-top: 38px; background: var(--board-bg); color: var(--board-text); border-radius: 16px; padding: 26px; display: grid; grid-template-columns: 260px 1fr; gap: 24px; overflow: hidden; position: relative; }
    .board:after { content: ""; position: absolute; width: 250px; height: 250px; border-radius: 50%; right: -90px; top: -110px; background: radial-gradient(circle, rgba(227, 162, 59, .28), transparent 70%); }
    .board-copy, .board-list { position: relative; z-index: 1; }
    .board-copy .eyebrow { color: #F3BC5F; margin-bottom: 7px; }
    .board-copy h3 { font-family: 'Playfair Display', serif; font-size: 26px; line-height: 1.12; margin: 0 0 8px; }
    .board-copy p { margin: 0; color: var(--board-muted); font-size: 12px; line-height: 1.6; }
    .board-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    .board-item { background: var(--board-item); border: 1px solid var(--board-border); border-radius: 11px; padding: 13px; text-align: center; }
    .rank { width: 28px; height: 28px; border-radius: 50%; margin: 0 auto 7px; display: grid; place-items: center; background: var(--gold); color: var(--blue-dark); font-size: 12px; font-weight: 800; }
    .board-item:nth-child(2) .rank { background: #D8E1EA; }
    .board-item:nth-child(3) .rank { background: #CB8C4D; }
    .board-item .name { font-size: 12px; font-weight: 750; }
    .board-item .count { font-size: 10px; color: #AFC2D8; margin-top: 2px; }

    /* Footer */
    .footer { margin-top: 42px; padding-top: 22px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 20px; color: var(--muted); font-size: 12px; }
    .footer-links { display: flex; gap: 18px; font-weight: 750; color: var(--blue); }
    .footer-links a:hover { text-decoration: underline; }

    /* Responsive Styles */
    @media(max-width: 900px) {
      .sidebar { position: static; width: 100%; height: auto; border-right: 0; border-bottom: 1px solid var(--border); }
      .layout { display: block; }
      .main { margin-left: 0; width: 100%; padding: 28px 16px 50px; }
      .nav { flex-direction: row; overflow-x: auto; }
      .nav a { white-space: nowrap; }
      .nav-label, .side-mini { display: none; }
      .theme-switch { margin: 10px 0; }
      .header h2 { font-size: 42px; }
      .board { grid-template-columns: 1fr; }
      .board-list { grid-template-columns: repeat(2, 1fr); }
    }
    @media(max-width: 560px) {
      .header h2 { font-size: 34px; }
      .grade-head { align-items: flex-start; }
      .active-badge { font-size: 9px; }
      .file-link { width: 100%; justify-content: flex-start; }
      .board-list { grid-template-columns: 1fr 1fr; }
      .footer { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
